NODE_ENV="local"
PORT="3000"
DATABASE_PASSWORD="replace-with-local-database-password"
DATABASE_URL="postgresql://closet_ai:replace-with-local-database-password@localhost:5432/closet_ai?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-local-access-secret"
JWT_REFRESH_SECRET="replace-with-local-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
SETUP_SECRET="replace-with-private-setup-secret"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
JSON_PAYLOAD_LIMIT="1mb"
AUTH_BOOTSTRAP_RATE_LIMIT_MAX="5"
AUTH_BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS="300"
AUTH_LOGIN_RATE_LIMIT_MAX="5"
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"
AUTH_REFRESH_RATE_LIMIT_MAX="20"
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS="60"
OBJECT_STORAGE_ROOT="/data/closet-ai/objects"
WEATHER_BASE_URL="https://api.open-meteo.com"
OPENAI_API_KEY="replace-with-openai-api-key-when-enabled"
AI_OUTFIT_MODEL="replace-when-ai-is-enabled"
AI_VISION_MODEL="replace-when-ai-is-enabled"
AI_STYLE_MODEL="replace-when-ai-is-enabled"
AI_IMAGE_MODEL="replace-when-ai-is-enabled"
