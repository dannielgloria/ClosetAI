NODE_ENV="production"
PORT="3000"
CADDY_SITE_ADDRESS="closet.example.com"
CORS_ALLOWED_ORIGINS="https://closet.example.com"
TRUST_PROXY_HOPS="1"

DATABASE_PASSWORD="replace-with-strong-database-password"
DATABASE_URL="postgresql://closet_ai:replace-with-url-encoded-database-password@postgres:5432/closet_ai?schema=public"
JWT_ACCESS_SECRET="replace-with-strong-access-token-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-token-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
SETUP_SECRET="replace-with-private-setup-secret"

JSON_PAYLOAD_LIMIT="1mb"
AUTH_BOOTSTRAP_RATE_LIMIT_MAX="5"
AUTH_BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS="300"
AUTH_LOGIN_RATE_LIMIT_MAX="5"
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"
AUTH_REFRESH_RATE_LIMIT_MAX="20"
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS="60"

GARMENT_IMAGE_MAX_SIZE_MB="8"
GARMENT_IMAGE_ORPHAN_GRACE_HOURS="24"
GARMENT_IMAGE_CLEANUP_BATCH_SIZE="100"
GARMENT_IMAGE_CLEANUP_CRON="0 3 * * *"

WEATHER_BASE_URL="https://api.open-meteo.com/v1"
WEATHER_REQUEST_TIMEOUT_MS="5000"
WEATHER_CACHE_TTL_SECONDS="1200"

OPENAI_API_KEY="replace-with-openai-api-key"
AI_CONTEXT_MODEL="replace-with-openai-context-model"
AI_OUTFIT_MODEL="replace-with-openai-outfit-model"
AI_VISION_MODEL="replace-with-openai-vision-model"
AI_REQUEST_TIMEOUT_MS="10000"

RESTIC_REPOSITORY="replace-with-restic-repository"
RESTIC_PASSWORD="replace-with-restic-password"
