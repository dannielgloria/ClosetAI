generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GarmentCategory {
  TOP
  BOTTOM
  OUTERWEAR
  FOOTWEAR
  UNDERWEAR
  ACCESSORY
  SPORTSWEAR
  FORMALWEAR
  SLEEPWEAR
}

enum GarmentStatus {
  CLEAN_AVAILABLE
  WORN_REUSABLE
  LAUNDRY_BIN
  WASHING
  DRYING
  CLEAN_PENDING_STORAGE
  UNAVAILABLE
  REPAIR
  RETIRED
  DONATED
  DISCARDED
}

enum GarmentStateTransitionType {
  MARK_WORN_REUSABLE
  SEND_TO_LAUNDRY
  START_WASHING
  START_DRYING
  MARK_CLEAN_PENDING_STORAGE
  MARK_CLEAN_AVAILABLE
  MARK_UNAVAILABLE
  SEND_TO_REPAIR
  RETURN_FROM_REPAIR
  RETIRE
  RESTORE
  DONATE
  DISCARD
}

enum GarmentSubcategory {
  T_SHIRT
  SHIRT
  SWEATER
  HOODIE
  JACKET
  JEANS
  TROUSERS
  SHORTS
  SKIRT
  DRESS
  SNEAKERS
  BOOTS
  DRESS_SHOES
  SANDALS
  ACCESSORY
  UNKNOWN
}

enum GarmentPattern {
  SOLID
  STRIPED
  CHECKED
  PRINTED
  TEXTURED
  UNKNOWN
}

enum GarmentFit {
  SLIM
  REGULAR
  RELAXED
  OVERSIZED
  UNKNOWN
}

enum GarmentMaterial {
  COTTON
  DENIM
  WOOL
  LINEN
  LEATHER
  SYNTHETIC
  KNIT
  UNKNOWN
}

enum OutfitStatus {
  GENERATED
  PRESENTED
  SELECTED
  WORN
  REJECTED
  CANCELLED
}

enum OutfitFeedbackDecision {
  ACCEPTED
  REJECTED
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("households")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  householdId             String                   @map("household_id") @db.Uuid
  displayName             String                   @map("display_name")
  city                    String?
  latitude                Float?
  longitude               Float?
  timezone                String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  household               Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  garments                Garment[]
  outfits                 Outfit[]
  usageEvents             GarmentUsageEvent[]
  credential              UserCredential?
  authSessions            AuthSession[]
  outfitFeedback          OutfitFeedback[]
  garmentImages           GarmentImage[]
  garmentStateTransitions GarmentStateTransition[]

  @@index([householdId])
  @@map("users")
}

model UserCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  deviceName       String?   @map("device_name")
  devicePlatform   String?   @map("device_platform")
  userAgent        String?   @map("user_agent")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Garment {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  category          GarmentCategory
  subcategory       GarmentSubcategory?
  primaryColor      String                   @map("primary_color")
  secondaryColors   String[]                 @default([]) @map("secondary_colors")
  pattern           GarmentPattern?
  fit               GarmentFit?
  estimatedMaterial GarmentMaterial?         @map("estimated_material")
  formality         Int?
  status            GarmentStatus            @default(CLEAN_AVAILABLE)
  name              String?
  wearCount         Int                      @default(0) @map("wear_count")
  lastWornAt        DateTime?                @map("last_worn_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  images            GarmentImage[]
  outfitItems       OutfitItem[]
  usageEvents       GarmentUsageEvent[]
  stateTransitions  GarmentStateTransition[]

  @@index([userId, status])
  @@map("garments")
}

model GarmentStateTransition {
  id         String                     @id @default(uuid()) @db.Uuid
  garmentId  String                     @map("garment_id") @db.Uuid
  userId     String                     @map("user_id") @db.Uuid
  fromStatus GarmentStatus              @map("from_status")
  toStatus   GarmentStatus              @map("to_status")
  transition GarmentStateTransitionType
  createdAt  DateTime                   @default(now()) @map("created_at")
  garment    Garment                    @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([garmentId, createdAt])
  @@index([userId, createdAt])
  @@map("garment_state_transitions")
}

model GarmentImage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  garmentId String?  @map("garment_id") @db.Uuid
  objectKey String   @unique @map("object_key")
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment   Garment? @relation(fields: [garmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([garmentId])
  @@map("garment_images")
}

model Outfit {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  status      OutfitStatus        @default(GENERATED)
  explanation String
  score       Int
  selectedAt  DateTime?           @map("selected_at")
  wornAt      DateTime?           @map("worn_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OutfitItem[]
  usageEvents GarmentUsageEvent[]
  feedback    OutfitFeedback[]

  @@index([userId, status])
  @@map("outfits")
}

model OutfitFeedback {
  id        String                 @id @default(uuid()) @db.Uuid
  outfitId  String                 @map("outfit_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  decision  OutfitFeedbackDecision
  reason    String?
  createdAt DateTime               @default(now()) @map("created_at")
  outfit    Outfit                 @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([outfitId])
  @@index([userId, createdAt])
  @@map("outfit_feedback")
}

model OutfitItem {
  id        String  @id @default(uuid()) @db.Uuid
  outfitId  String  @map("outfit_id") @db.Uuid
  garmentId String  @map("garment_id") @db.Uuid
  position  Int
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Restrict)

  @@unique([outfitId, garmentId])
  @@index([garmentId])
  @@map("outfit_items")
}

model GarmentUsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  garmentId String   @map("garment_id") @db.Uuid
  outfitId  String   @map("outfit_id") @db.Uuid
  wornAt    DateTime @map("worn_at")
  context   Json     @default("{}")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Restrict)
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@unique([outfitId, garmentId])
  @@index([userId, wornAt])
  @@map("garment_usage_events")
}
